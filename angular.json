{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "@addapptables/ng-web-socket": {
      "root": "projects/addapptables/ng-web-socket",
      "sourceRoot": "projects/addapptables/ng-web-socket/src",
      "projectType": "library",
      "prefix": "addapptable",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "projects/addapptables/ng-web-socket/tsconfig.lib.json",
            "project": "projects/addapptables/ng-web-socket/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/addapptables/ng-web-socket/tsconfig.lib.prod.json"
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/addapptables/ng-web-socket/**/*.ts"
            ]
          }
        }
      }
    },
    "@addapptables/ng-socket-io": {
      "root": "projects/addapptables/ng-socket-io",
      "sourceRoot": "projects/addapptables/ng-socket-io/src",
      "projectType": "library",
      "prefix": "addapptable",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "projects/addapptables/ng-socket-io/tsconfig.lib.json",
            "project": "projects/addapptables/ng-socket-io/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/addapptables/ng-socket-io/tsconfig.lib.prod.json"
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/addapptables/ng-socket-io/**/*.ts"
            ]
          }
        }
      }
    },
    "@addapptables/ng-signal-r": {
      "root": "projects/addapptables/ng-signal-r",
      "sourceRoot": "projects/addapptables/ng-signal-r/src",
      "projectType": "library",
      "prefix": "addapptable",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "projects/addapptables/ng-signal-r/tsconfig.lib.json",
            "project": "projects/addapptables/ng-signal-r/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/addapptables/ng-signal-r/tsconfig.lib.prod.json"
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/addapptables/ng-signal-r/**/*.ts"
            ]
          }
        }
      }
    }
  }
}
